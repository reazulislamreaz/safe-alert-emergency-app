# ==============================================================================
# SafeAlert Production & Docker Compose Configuration
# ==============================================================================

# Application Ports
FRONTEND_PORT=3000
BACKEND_PORT=5000

# Server Environment & Secrets
NODE_ENV=production
JWT_SECRET=safealert_super_secret_jwt_key_2026_production
CORS_ORIGIN=*
DASHBOARD_ADMIN_EMAIL=admin@safealert.app

# PostgreSQL Database Configuration
POSTGRES_USER=safealert
POSTGRES_PASSWORD=safealert_secure_password_2026
POSTGRES_DB=safealert_db
POSTGRES_PORT=5432

# S3 image uploads (dashboard + profile photos).
# Either AWS_S3_BUCKET or AWS_S3_BUCKET_NAME is accepted.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_BUCKET_NAME=
AWS_S3_PUBLIC_BASE_URL=

# Google Maps JavaScript API (browser key). Used by the dashboard and citizen maps.
GOOGLE_MAPS_API_KEY=

# ZegoCloud video calls (Token04). ServerSecret must be exactly 32 characters.
ZEGO_APP_ID=
ZEGO_SERVER_SECRET=
ZEGO_SERVER=

# SMTP (password-reset OTP and transactional email).
# For Gmail use an App Password, not the account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
