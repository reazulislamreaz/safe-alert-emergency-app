# ==============================================================================
# SafeAlert Production & Docker Compose Configuration
# ==============================================================================

# Application Ports
FRONTEND_PORT=3000
BACKEND_PORT=5000

# Server Environment & Secrets
NODE_ENV=production
JWT_SECRET=safealert_super_secret_jwt_key_2026_production
CORS_ORIGIN=*
DASHBOARD_ADMIN_EMAIL=admin@safealert.app

# PostgreSQL Database Configuration
POSTGRES_USER=safealert
POSTGRES_PASSWORD=safealert_secure_password_2026
POSTGRES_DB=safealert_db
POSTGRES_PORT=5432

# ZEGOCLOUD (optional — live group video). Leave empty for demo room ids.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_PUBLIC_BASE_URL=
