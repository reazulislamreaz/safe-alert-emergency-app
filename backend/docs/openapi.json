me":"Auth","description":"Register, login, OTP, PIN, password reset"},{"name":"Alerts","description":"SOS trigger, telemetry, resolve"},{"name":"Contacts","description":"Emergency groups and members"},{"name":"Catalog","description":"Public emergency types and incident journals"},{"name":"Dashboard","description":"Admin metrics, users, types, subscriptions"}],"servers":[],"components":{"securitySchemes":{"access-token":{"scheme":"bearer","bearerFormat":"JWT","type":"http","description":"JWT from POST /api/auth/login"}},"schemas":{"RegisterDto":{"type":"object","properties":{"fullName":{"type":"string","minLength":2,"example":"Jordan Lee"},"email":{"type":"string","format":"email","example":"jordan.lee@example.com"},"phone":{"type":"string","minLength":7,"example":"+1 (555) 321-0987"},"dob":{"type":"string","example":"1998-05-14"},"race":{"type":"string","example":"White"},"location":{"type":"string","example":"New York, NY"},"emergencyContactName":{"type":"string","minLength":2,"example":"James Johnson"},"emergencyContactPhone":{"type":"string","minLength":7,"example":"+1 (555) 987-6543"},"emergencyContactRelation":{"type":"string","minLength":2,"example":"Father"},"profilePhotos":{"example":["https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=300"],"type":"array","items":{"type":"string"}},"pin":{"type":"string","pattern":"^\\d{4}$","example":"1234","description":"4-digit de-escalation PIN"},"password":{"type":"string","minLength":6,"example":"password123"}},"required":["fullName","email","phone","emergencyContactName","emergencyContactPhone","emergencyContactRelation"]},"SendOtpDto":{"type":"object","properties":{"phone":{"type":"string","minLength":7,"example":"+1 (555) 234-5678"}},"required":["phone"]},"VerifyOtpDto":{"type":"object","properties":{"phone":{"type":"string","minLength":7,"example":"+1 (555) 234-5678"},"code":{"type":"string","minLength":6,"maxLength":6,"example":"123456","description":"Demo code for Sarah's phone is 123456"}},"required":["phone","code"]},"SetupPinDto":{"type":"object","properties":{"userId":{"type":"string","example":"usr-sarah-101"},"pin":{"type":"string","pattern":"^\\d{4}$","example":"1234"}},"required":["userId","pin"]},"VerifyPinDto":{"type":"object","properties":{"userId":{"type":"string","example":"usr-sarah-101","description":"Defaults to the JWT subject, then Sarah's demo user."},"pin":{"type":"string","pattern":"^\\d{4}$","example":"1234"}},"required":["pin"]},"LoginDto":{"type":"object","properties":{"emailOrPhone":{"type":"string","minLength":3,"example":"admin@safealert.app","description":"Email address or phone number"},"pin":{"type":"string","pattern":"^\\d{4}$","example":"1234","description":"Citizen 4-digit PIN. Send this or password, not both required."},"password":{"type":"string","minLength":4,"example":"adminpassword","description":"Admin / password login. Use adminpassword or opspassword for demo admins."}},"required":["emailOrPhone"]},"ForgotPasswordDto":{"type":"object","properties":{"email":{"type":"string","format":"email","example":"admin@safealert.app"}},"required":["email"]},"VerifyResetOtpDto":{"type":"object","properties":{"email":{"type":"string","format":"email","example":"admin@safealert.app"},"code":{"type":"string","minLength":6,"maxLength":6,"pattern":"^\\d{6}$","example":"123456"}},"required":["email","code"]},"ResetPasswordDto":{"type":"object","properties":{"email":{"type":"string","format":"email","example":"admin@safealert.app"},"code":{"type":"string","minLength":6,"maxLength":6,"pattern":"^\\d{6}$","example":"123456"},"newPassword":{"type":"string","minLength":6,"example":"adminpassword"}},"required":["email","code","newPassword"]},"TriggerAlertDto":{"type":"object","properties":{"userId":{"type":"string","example":"usr-sarah-101"},"emergencyTypeId":{"type":"string","example":"et-assault"},"mode":{"enum":["EMERGENCY","SILENT","TEST"],"type":"string","example":"EMERGENCY"},"latitude":{"type":"number","example":40.712776},"longitude":{"type":"number","example":-74.005974},"address":{"type":"string","example":"123 Main St, New York, NY 10001"}}},"TelemetryDto":{"type":"object","properties":{"latitude":{"type":"number","example":40.71285},"longitude":{"type":"number","example":-74.00602},"speed":{"type":"number","minimum":0,"example":1.5},"heading":{"type":"number","example":95},"accuracy":{"type":"number","example":3},"batteryLevel":{"type":"number","example":84}},"required":["latitude","longitude"]},"ResolveAlertDto":{"type":"object","properties":{"reason":{"enum":["SAFE","FALSE_ALARM","TEST"],"type":"string","example":"SAFE"},"notes":{"type":"string","example":"Reached a safe location."},"pin":{"type":"string","example":"1234","description":"User's 4-digit PIN"},"userId":{"type":"string","example":"usr-sarah-101"}}},"CreateGroupDto":{"type":"object","properties":{"userId":{"type":"string","example":"usr-sarah-101"},"name":{"type":"string","example":"Close Friends"},"color":{"type":"string","example":"#3A67D5"}},"required":["name"]},"AddMemberDto":{"type":"object","properties":{"groupId":{"type":"string","example":"grp-family-01"},"name":{"type":"string","example":"Alex Rivera"},"phone":{"type":"string","example":"+1 (555) 222-1111"},"relationship":{"type":"string","example":"Friend"}},"required":["groupId","name","phone","relationship"]},"CreateEmergencyTypeDto":{"type":"object","properties":{"key":{"type":"string","example":"FLOOD"},"label":{"type":"string","example":"Flood / Water Rescue"},"severity":{"enum":["LOW","URGENT","HIGH","CRITICAL"],"type":"string","example":"HIGH"},"icon":{"type":"string","example":"Waves"},"description":{"type":"string","example":"Rapid water rise or trapped occupants"},"isActive":{"type":"boolean","example":true}},"required":["key","label","severity","icon","description"]}}}}