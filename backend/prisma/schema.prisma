generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  OPS_ADMIN
  SUPER_ADMIN
}

enum SubscriptionTier {
  FREE
  PREMIUM
}

enum Severity {
  LOW
  URGENT
  HIGH
  CRITICAL
}

enum AlertMode {
  EMERGENCY
  SILENT
  TEST
}

enum AlertSource {
  MANUAL
  QUICK
  SOS
}

enum AlertStatus {
  TRIGGERED
  BROADCASTING
  RESOLVED
  CANCELLED
}

enum MessageType {
  SOS
  QUICK_REPLY
  USER
}

enum DeliveryStatus {
  DELIVERED
  PENDING
}

enum JournalEntryType {
  INCIDENT
  TEST
  UPDATE
}

enum JournalSource {
  MANUAL
  ALERT
}

enum NotificationType {
  DIRECT_ALERT
  ALERT_RECEIVED
  ALERT_CANCELLED
  CONTACT_ADDED
  SUBSCRIPTION
  GROUP_INVITE
  RESPONDER_UPDATE
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model User {
  id                        String            @id @default(uuid())
  fullName                  String
  email                     String            @unique
  phone                     String            @unique
  phoneDigits               String
  role                      Role              @default(USER)
  subscriptionTier          SubscriptionTier  @default(FREE)
  isVerified                Boolean           @default(false)
  isPhoneVerified           Boolean           @default(false)
  pinHash                   String
  passwordHash              String?
  avatar                    String?
  profilePhotos             String[]          @default([])
  dob                       String?
  race                      String?
  location                  String?
  emergencyContactName      String?
  emergencyContactPhone     String?
  emergencyContactRelation  String?
  subscriptionStartedAt     DateTime?
  subscriptionRenewsAt      DateTime?
  subscriptionCancelledAt   DateTime?
  subscriptionCancelReason  String?
  trialEndsAt               DateTime?
  faceIdEnabled             Boolean           @default(false)
  createdAt                 DateTime          @default(now())
  contactGroups             ContactGroup[]
  contacts                  Contact[]
  alerts                    Alert[]
  journals                  Journal[]
  notifications             Notification[]
  sentInvitations           GroupInvitation[] @relation("InvitationInviter")
  receivedInvitations       GroupInvitation[] @relation("InvitationInvitee")

  @@index([phoneDigits])
  @@index([role])
  @@map("users")
}

model PhoneOtp {
  phone      String   @id
  code       String
  expiresAt  DateTime
  attempts   Int      @default(0)
  verified   Boolean  @default(false)

  @@map("phone_otps")
}

model EmailOtp {
  email      String   @id
  code       String
  expiresAt  DateTime
  attempts   Int      @default(0)
  verified   Boolean  @default(false)

  @@map("email_otps")
}

model Contact {
  id            String          @id
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  phone         String
  phoneDigits   String
  relationship  String
  createdAt     DateTime        @default(now())
  memberships   ContactMember[]

  @@unique([userId, phoneDigits])
  @@index([userId])
  @@index([phoneDigits])
  @@map("contacts")
}

model ContactGroup {
  id           String             @id @default(uuid())
  userId       String
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  color        String             @default("#3A67D5")
  isDefaultSOS Boolean            @default(true)
  memberCount  Int                @default(0)
  members      ContactMember[]
  invitations  GroupInvitation[]

  @@index([userId])
  @@map("contact_groups")
}

model ContactMember {
  id           String       @id @default(uuid())
  groupId      String
  group        ContactGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  contactId    String?
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  name         String
  phone        String
  phoneDigits  String       @default("")
  relationship String
  isJoinedCall Boolean      @default(false)

  @@index([groupId])
  @@index([contactId])
  @@index([phoneDigits])
  @@map("contact_members")
}

model GroupInvitation {
  id                 String           @id @default(uuid())
  groupId            String
  group              ContactGroup     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  inviterId          String
  inviter            User             @relation("InvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  inviteeUserId      String?
  invitee            User?            @relation("InvitationInvitee", fields: [inviteeUserId], references: [id], onDelete: SetNull)
  inviteePhone       String
  inviteePhoneDigits String
  inviteeName        String?
  status             InvitationStatus @default(PENDING)
  createdAt          DateTime         @default(now())
  respondedAt        DateTime?

  @@index([inviteePhoneDigits, status])
  @@index([inviteeUserId, status])
  @@index([groupId])
  @@map("group_invitations")
}

model EmergencyType {
  id          String    @id @default(uuid())
  key         String    @unique
  label       String
  severity    Severity
  icon        String
  description String
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  alerts      Alert[]

  @@map("emergency_types")
}

model Alert {
  id                   String               @id @default(uuid())
  userId               String
  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  userName             String
  userPhone            String
  emergencyTypeId      String
  emergencyType        EmergencyType        @relation(fields: [emergencyTypeId], references: [id])
  emergencyTypeLabel   String
  severity             Severity
  mode                 AlertMode            @default(EMERGENCY)
  source               AlertSource          @default(MANUAL)
  status               AlertStatus          @default(BROADCASTING)
  latitude             Float
  longitude            Float
  address              String
  roomId               String?
  telemetryHistory     TelemetryPoint[]
  notifiedGroups       AlertNotifiedGroup[]
  participants         Json                 @default("[]")
  liveMessages         LiveMessage[]
  triggeredAt          DateTime             @default(now())
  resolvedAt           DateTime?
  resolutionReason     String?
  resolutionNotes      String?

  @@index([userId])
  @@index([status])
  @@map("alerts")
}

model TelemetryPoint {
  id           String   @id @default(uuid())
  alertId      String
  alert        Alert    @relation(fields: [alertId], references: [id], onDelete: Cascade)
  latitude     Float
  longitude    Float
  accuracy     Float    @default(3)
  speed        Float    @default(0)
  heading      Float    @default(0)
  batteryLevel Float    @default(85)
  timestamp    DateTime @default(now())

  @@index([alertId])
  @@map("telemetry_points")
}

model AlertNotifiedGroup {
  id             String         @id @default(uuid())
  alertId        String
  alert          Alert          @relation(fields: [alertId], references: [id], onDelete: Cascade)
  groupId        String
  groupName      String
  memberCount    Int
  deliveryStatus DeliveryStatus @default(DELIVERED)

  @@index([alertId])
  @@map("alert_notified_groups")
}

model LiveMessage {
  id            String      @id @default(uuid())
  alertId       String
  alert         Alert       @relation(fields: [alertId], references: [id], onDelete: Cascade)
  sender        String
  senderUserId  String?
  text          String
  timestamp     String
  type          MessageType @default(USER)
  createdAt     DateTime    @default(now())

  @@index([alertId])
  @@map("live_messages")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  refLabel  String?
  alertId   String?
  contactId String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
  @@map("notifications")
}

model Journal {
  id               String           @id @default(uuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type             JournalEntryType @default(UPDATE)
  body             String           @default("")
  source           JournalSource    @default(MANUAL)
  emergencyType    String?
  severity         String?
  status           String?
  resolutionReason String?
  resolutionNotes  String?
  location         String?
  triggeredAt      DateTime         @default(now())
  duration         String?
  createdAt        DateTime         @default(now())

  @@index([userId])
  @@index([triggeredAt])
  @@map("journals")
}

model SubscriptionPlan {
  id              String   @id
  name            String
  priceMonthly    Float
  priceYearly     Float
  maxContacts     Int
  maxGroups       Int
  features        String[]
  subscriberCount Int      @default(0)

  @@map("subscription_plans")
}

model LegalPage {
  slug      String   @id
  title     String
  body      String
  updatedAt DateTime @updatedAt

  @@map("legal_pages")
}

model RevokedToken {
  tokenHash String   @id
  expiresAt DateTime

  @@index([expiresAt])
  @@map("revoked_tokens")
}
