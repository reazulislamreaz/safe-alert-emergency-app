generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  SUPER_ADMIN
  SECURITY_OPERATOR
}

enum SubscriptionTier {
  FREE
  PREMIUM
}

enum Severity {
  LOW
  URGENT
  HIGH
  CRITICAL
}

enum AlertMode {
  EMERGENCY
  SILENT
  TEST
}

enum AlertSource {
  MANUAL
  QUICK
  SOS
}

enum AlertStatus {
  TRIGGERED
  BROADCASTING
  RESOLVED
  CANCELLED
}

enum MessageType {
  SOS
  QUICK_REPLY
  USER
}

enum DeliveryStatus {
  DELIVERED
  PENDING
}

enum JournalEntryType {
  INCIDENT
  TEST
  UPDATE
}

enum JournalSource {
  MANUAL
  ALERT
}

enum NotificationType {
  DIRECT_ALERT
  ALERT_RECEIVED
  ALERT_CANCELLED
  CONTACT_ADDED
  SUBSCRIPTION
  GROUP_INVITE
  RESPONDER_UPDATE
  SAFETY_COUNTDOWN
  FOLLOW_UP_ALERT
  LOCATION_REQUEST
  BYSTANDER
  PROMO
  COUNTDOWN_ESCALATED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum ContactGroupKind {
  FAMILY_FRIENDS
  GENERAL
}

enum SafetyCountdownStatus {
  ACTIVE
  CONFIRMED_SAFE
  CANCELLED
  ESCALATED
}

enum ScheduledJobType {
  COUNTDOWN_EXPIRE
  ALERT_FOLLOW_UP
  PROMO_EXPIRE
  PREMIUM_EXPIRE
  LOCATION_REQUEST_EXPIRE
}

enum ScheduledJobStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
  CANCELLED
}

enum LocationRequestStatus {
  PENDING
  APPROVED
  DECLINED
  EXPIRED
}

enum PromoCodeStatus {
  ACTIVE
  DISABLED
  EXPIRED
}

enum MediaType {
  IMAGE
  VIDEO
  NONE
}

model User {
  id                        String            @id @default(uuid())
  fullName                  String
  email                     String            @unique
  phone                     String?           @unique
  phoneDigits               String            @default("")
  role                      Role              @default(USER)
  subscriptionTier          SubscriptionTier  @default(FREE)
  isVerified                Boolean           @default(false)
  isPhoneVerified           Boolean           @default(false)
  pinHash                   String?
  passwordHash              String?
  avatar                    String?
  profilePhotos             String[]          @default([])
  dob                       String?
  race                      String?
  location                  String?
  emergencyContactName      String?
  emergencyContactPhone     String?
  emergencyContactRelation  String?
  subscriptionStartedAt     DateTime?
  subscriptionRenewsAt      DateTime?
  subscriptionCancelledAt   DateTime?
  subscriptionCancelReason  String?
  trialEndsAt               DateTime?
  faceIdEnabled             Boolean           @default(false)
  faceIdCredentialId        String?
  createdAt                 DateTime          @default(now())
  contactGroups             ContactGroup[]
  contacts                  Contact[]
  alerts                    Alert[]
  journals                  Journal[]
  notifications             Notification[]
  sentInvitations           GroupInvitation[] @relation("InvitationInviter")
  receivedInvitations       GroupInvitation[] @relation("InvitationInvitee")
  safetyCountdowns          SafetyCountdown[]
  locationRequestsSent      LocationRequest[] @relation("LocationRequester")
  locationRequestsReceived  LocationRequest[] @relation("LocationTarget")
  promoRedemptions          PromoRedemption[]
  coverageAsOperator        DashboardCoverage[] @relation("CoverageOperator")
  coverageAsSubscriber      DashboardCoverage[] @relation("CoverageSubscriber")
  conversationsAsUserA      Conversation[]    @relation("ConversationUserA")
  conversationsAsUserB      Conversation[]    @relation("ConversationUserB")
  directMessagesSent        DirectMessage[]
  bystanderRelaysSent       BystanderRelay[]  @relation("BystanderSender")
  bystanderRelaysReceived   BystanderRelay[]  @relation("BystanderTarget")
  devicePushTokens          DevicePushToken[]

  @@index([phoneDigits])
  @@index([role])
  @@map("users")
}

model PhoneOtp {
  phone      String   @id
  code       String
  expiresAt  DateTime
  attempts   Int      @default(0)
  verified   Boolean  @default(false)

  @@map("phone_otps")
}

model EmailOtp {
  email      String   @id
  code       String
  expiresAt  DateTime
  attempts   Int      @default(0)
  verified   Boolean  @default(false)

  @@map("email_otps")
}

model Contact {
  id            String          @id
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  phone         String
  phoneDigits   String
  relationship  String
  createdAt     DateTime        @default(now())
  memberships   ContactMember[]

  @@unique([userId, phoneDigits])
  @@index([userId])
  @@index([phoneDigits])
  @@map("contacts")
}

model ContactGroup {
  id           String             @id @default(uuid())
  userId       String
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  color        String             @default("#3A67D5")
  isDefaultSOS Boolean            @default(true)
  kind         ContactGroupKind   @default(GENERAL)
  memberCount  Int                @default(0)
  members      ContactMember[]
  invitations  GroupInvitation[]
  locationRequests LocationRequest[]
  bystanderRelays  BystanderRelay[]

  @@index([userId])
  @@index([kind])
  @@map("contact_groups")
}

model ContactMember {
  id           String       @id @default(uuid())
  groupId      String
  group        ContactGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  contactId    String?
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  name         String
  phone        String
  phoneDigits  String       @default("")
  relationship String
  isJoinedCall Boolean      @default(false)

  @@index([groupId])
  @@index([contactId])
  @@index([phoneDigits])
  @@map("contact_members")
}

model GroupInvitation {
  id                 String           @id @default(uuid())
  groupId            String
  group              ContactGroup     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  inviterId          String
  inviter            User             @relation("InvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  inviteeUserId      String?
  invitee            User?            @relation("InvitationInvitee", fields: [inviteeUserId], references: [id], onDelete: SetNull)
  inviteePhone       String
  inviteePhoneDigits String
  inviteeName        String?
  status             InvitationStatus @default(PENDING)
  token              String?          @unique
  expiresAt          DateTime?
  maxUses            Int              @default(1)
  useCount           Int              @default(0)
  createdAt          DateTime         @default(now())
  respondedAt        DateTime?

  @@index([inviteePhoneDigits, status])
  @@index([inviteeUserId, status])
  @@index([groupId])
  @@index([token])
  @@map("group_invitations")
}

model EmergencyType {
  id          String    @id @default(uuid())
  key         String    @unique
  label       String
  severity    Severity
  icon        String
  description String
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  alerts      Alert[]

  @@map("emergency_types")
}

model Alert {
  id                   String               @id @default(uuid())
  userId               String
  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  userName             String
  userPhone            String
  emergencyTypeId      String
  emergencyType        EmergencyType        @relation(fields: [emergencyTypeId], references: [id])
  emergencyTypeLabel   String
  severity             Severity
  mode                 AlertMode            @default(EMERGENCY)
  source               AlertSource          @default(MANUAL)
  status               AlertStatus          @default(BROADCASTING)
  latitude             Float
  longitude            Float
  address              String
  roomId               String?
  telemetryHistory     TelemetryPoint[]
  notifiedGroups       AlertNotifiedGroup[]
  participants         Json                 @default("[]")
  liveMessages         LiveMessage[]
  triggeredAt          DateTime             @default(now())
  resolvedAt           DateTime?
  resolutionReason     String?
  resolutionNotes      String?
  followUpSentAt       DateTime?
  safetyCountdowns     SafetyCountdown[]
  bystanderRelays      BystanderRelay[]

  @@index([userId])
  @@index([status])
  @@map("alerts")
}

model TelemetryPoint {
  id           String   @id @default(uuid())
  alertId      String
  alert        Alert    @relation(fields: [alertId], references: [id], onDelete: Cascade)
  latitude     Float
  longitude    Float
  accuracy     Float    @default(3)
  speed        Float    @default(0)
  heading      Float    @default(0)
  /// Null when the client did not report battery — do not invent a default.
  batteryLevel Float?
  timestamp    DateTime @default(now())

  @@index([alertId])
  @@map("telemetry_points")
}

model AlertNotifiedGroup {
  id             String         @id @default(uuid())
  alertId        String
  alert          Alert          @relation(fields: [alertId], references: [id], onDelete: Cascade)
  groupId        String
  groupName      String
  memberCount    Int
  deliveryStatus DeliveryStatus @default(DELIVERED)

  @@index([alertId])
  @@map("alert_notified_groups")
}

model LiveMessage {
  id            String      @id @default(uuid())
  alertId       String
  alert         Alert       @relation(fields: [alertId], references: [id], onDelete: Cascade)
  sender        String
  senderUserId  String?
  text          String
  timestamp     String
  type          MessageType @default(USER)
  mediaUrl      String?
  mediaType     MediaType   @default(NONE)
  mimeType      String?
  createdAt     DateTime    @default(now())

  @@index([alertId])
  @@map("live_messages")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  refLabel  String?
  alertId   String?
  contactId String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
  @@map("notifications")
}

model Journal {
  id               String           @id @default(uuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type             JournalEntryType @default(INCIDENT)
  body             String           @default("")
  source           JournalSource    @default(MANUAL)
  emergencyType    String?
  severity         String?
  status           String?
  resolutionReason String?
  resolutionNotes  String?
  location         String?
  /// Snapshot of emergency media (from live messages) at close time.
  mediaItems       Json             @default("[]")
  alertId          String?
  triggeredAt      DateTime         @default(now())
  duration         String?
  createdAt        DateTime         @default(now())

  @@index([userId])
  @@index([triggeredAt])
  @@index([alertId])
  @@map("journals")
}

model SubscriptionPlan {
  id              String   @id
  name            String
  priceMonthly    Float
  priceYearly     Float
  maxContacts     Int
  maxGroups       Int
  features        String[]
  subscriberCount Int      @default(0)

  @@map("subscription_plans")
}

model LegalPage {
  slug      String   @id
  title     String
  body      String
  updatedAt DateTime @updatedAt

  @@map("legal_pages")
}

model RevokedToken {
  tokenHash String   @id
  expiresAt DateTime

  @@index([expiresAt])
  @@map("revoked_tokens")
}

model SafetyCountdown {
  id          String                 @id @default(uuid())
  userId      String
  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      SafetyCountdownStatus  @default(ACTIVE)
  startedAt   DateTime               @default(now())
  expiresAt   DateTime
  confirmedAt DateTime?
  cancelledAt DateTime?
  escalatedAt DateTime?
  alertId     String?
  alert       Alert?                 @relation(fields: [alertId], references: [id], onDelete: SetNull)
  notes       String?

  @@index([userId, status])
  @@index([expiresAt, status])
  @@map("safety_countdowns")
}

model ScheduledJob {
  id          String             @id @default(uuid())
  type        ScheduledJobType
  refId       String
  runAt       DateTime
  status      ScheduledJobStatus @default(PENDING)
  attempts    Int                @default(0)
  lastError   String?
  processedAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([type, refId])
  @@index([status, runAt])
  @@map("scheduled_jobs")
}

model LocationRequest {
  id              String                @id @default(uuid())
  requesterId     String
  requester       User                  @relation("LocationRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  targetUserId    String
  target          User                  @relation("LocationTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  groupId         String
  group           ContactGroup          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  status          LocationRequestStatus @default(PENDING)
  latitude        Float?
  longitude       Float?
  address         String?
  respondedAt     DateTime?
  expiresAt       DateTime?
  createdAt       DateTime              @default(now())

  @@index([targetUserId, status])
  @@index([requesterId, status])
  @@index([groupId])
  @@map("location_requests")
}

model PromoCode {
  id              String          @id @default(uuid())
  code            String          @unique
  campaignName    String
  durationMonths  Int
  maxRedemptions  Int             @default(1)
  redemptionCount Int             @default(0)
  expiresAt       DateTime?
  status          PromoCodeStatus @default(ACTIVE)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  redemptions     PromoRedemption[]

  @@index([status])
  @@map("promo_codes")
}

model PromoRedemption {
  id         String    @id @default(uuid())
  promoCodeId String
  promoCode  PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  redeemedAt DateTime  @default(now())
  grantedUntil DateTime

  @@unique([promoCodeId, userId])
  @@index([userId])
  @@map("promo_redemptions")
}

/// Future-ready: operator → subscriber coverage. Super Admin currently sees all.
model DashboardCoverage {
  id               String   @id @default(uuid())
  operatorUserId   String
  operator         User     @relation("CoverageOperator", fields: [operatorUserId], references: [id], onDelete: Cascade)
  subscriberUserId String
  subscriber       User     @relation("CoverageSubscriber", fields: [subscriberUserId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())

  @@unique([operatorUserId, subscriberUserId])
  @@index([operatorUserId])
  @@index([subscriberUserId])
  @@map("dashboard_coverage")
}

model Conversation {
  id           String          @id @default(uuid())
  userAId      String
  userA        User            @relation("ConversationUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userBId      String
  userB        User            @relation("ConversationUserB", fields: [userBId], references: [id], onDelete: Cascade)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  messages     DirectMessage[]

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
  @@map("conversations")
}

model DirectMessage {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUserId   String
  sender         User         @relation(fields: [senderUserId], references: [id], onDelete: Cascade)
  text           String       @default("")
  mediaUrl       String?
  mediaType      MediaType    @default(NONE)
  mimeType       String?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([senderUserId])
  @@map("direct_messages")
}

model BystanderRelay {
  id               String   @id @default(uuid())
  senderUserId     String
  sender           User     @relation("BystanderSender", fields: [senderUserId], references: [id], onDelete: Cascade)
  targetUserId     String?
  target           User?    @relation("BystanderTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  targetPhone      String
  targetPhoneDigits String
  targetName       String?
  groupId          String
  group            ContactGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  alertId          String?
  alert            Alert?   @relation(fields: [alertId], references: [id], onDelete: SetNull)
  message          String
  /// Email/SMS delivery channel used for non-app recipients (if any).
  outboundChannel  String?
  outboundStatus   String?
  createdAt        DateTime @default(now())

  /// One-time: a sender may relay to a given circle contact only once.
  @@unique([senderUserId, groupId, targetPhoneDigits])
  @@index([senderUserId])
  @@index([groupId])
  @@index([alertId])
  @@map("bystander_relays")
}

model DevicePushToken {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String
  platform   String   @default("unknown")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, token])
  @@index([userId])
  @@map("device_push_tokens")
}
