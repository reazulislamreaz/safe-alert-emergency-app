PORT=5000
NODE_ENV=development
JWT_SECRET=safealert_super_secret_jwt_key_2026_production
JWT_EXPIRES_IN=7d
CORS_ORIGIN=*
OTP_EXPIRY_MINUTES=10
DATABASE_URL=postgresql://safealert:safealert_secure_password_2026@localhost:5432/safealert_db?schema=public

# S3 image uploads. Either AWS_S3_BUCKET or AWS_S3_BUCKET_NAME works.
# Leave both empty to store files under backend/uploads in development.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_BUCKET_NAME=
AWS_S3_PUBLIC_BASE_URL=

# Designated Super Admin for the Dashboard (created/promoted by seed, not public registration).
DASHBOARD_ADMIN_EMAIL=admin@safealert.app

# Google Maps JavaScript API (browser key). Used by dashboard and citizen maps.
GOOGLE_MAPS_API_KEY=

# SMTP (password-reset OTP and transactional email).
# For Gmail use an App Password, not the account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
